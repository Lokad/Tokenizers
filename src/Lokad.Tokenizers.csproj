<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Lokad.Tokenizers</PackageId>
    <Title>Lokad.Tokenizers</Title>
    <Authors>Lokad</Authors>
    <Company>Lokad</Company>
    <Description>Managed XLM-R and Gemma tokenizers for text embedding models on .NET.</Description>
    <Version>0.2.0</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>See CHANGELOG.md for release details.</PackageReleaseNotes>
    <PackageTags>tokenization;nlp;embedding;gemma;sentencepiece;xlm-roberta</PackageTags>
    <PackageProjectUrl>https://github.com/Lokad/Tokenizers</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Lokad/Tokenizers</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <ContinuousIntegrationBuild Condition="'$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageOutputPath>../artifacts/nuget/</PackageOutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../LICENSE.txt;../README.md;../CHANGELOG.md;../icon.png" Pack="true" PackagePath="/" Visible="false" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
  <Target Name="EnforceReleasePackageConfiguration" BeforeTargets="GenerateNuspec"
          Condition="'$(Configuration)' != 'Release' and '$(AllowNonReleasePackage)' != 'true'">
    <Error Text="NuGet packages must be produced with -c Release. Pass /p:AllowNonReleasePackage=true only for troubleshooting." />
  </Target>
</Project>
